{
    "manifest_version": 3,
    "name": "XHR Interceptor w/ React",
    "version": "1.0.0",
    "description": "XHR Interceptor. Built with React and Vite Plugin Web Extension.",
    "action": {
        "default_popup": "src/ui/popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["src/content.ts", "src/xhrInterceptor.ts"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["src/xhrInterceptor.js"],
            "matches": ["*://9gag.com/*"]
        }
    ],
    "permissions": ["webRequest"]
}
