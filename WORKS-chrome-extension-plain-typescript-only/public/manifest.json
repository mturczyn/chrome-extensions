{
  "manifest_version": 3,
  "name": "My TypeScript Extension",
  "version": "1.0.0",
  "description": "Built with TypeScript and Vite",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [{
      "resources": ["injected.js"],
      "matches": ["*://9gag.com/*"]
  }],
  "permissions": [ "webRequest"]
}
