{
  "manifest_version": 3,
  "name": "Vanilla TS Extension Is it working?",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts", "src/xhrInterceptor.ts"]
    }
  ],
  "web_accessible_resources": [{
      "resources": ["src/xhrInterceptor.js"],
      "matches": ["*://9gag.com/*"]
  }],
  "permissions": ["webRequest"]
}
